---
import Arrow from './Arrow.astro';
import SocialIcon from './SocialIcon.astro';
import { local } from '../lib/urls';
import { projectMedia } from '../data/project-media';
import media from '../data/media.json';
const { project, wide = false, showRepository = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const cover = projectMedia[project.slug];
const imagePath = local(`images/evidence/${cover.file}`);
const size = media[cover.file as keyof typeof media];
const srcset = cover.small ? `${local(`images/evidence/${cover.small}`)} 640w, ${imagePath} ${size.width}w` : undefined;
---
<article class:list={['project-preview', { 'project-wide': wide }]}>
  <figure class="project-visual">
    <a class:list={['project-art', `art-${cover.tone}`]} href={local(`work/${project.slug}/`)} aria-label={`Read about ${project.title}`} tabindex="-1">
      <img src={imagePath} srcset={srcset} sizes={srcset && '(max-width: 700px) 100vw, 1200px'} width={size.width} height={size.height} loading="lazy" decoding="async" alt={cover.alt} />
    </a>
    <figcaption>{cover.caption}{cover.credit && <> · <a href={cover.credit.href}>{cover.credit.text}</a></>}</figcaption>
  </figure>
  <div class="project-caption">
    <div><p class="project-meta">{project.category}<span aria-hidden="true"> · </span>{project.tools}</p><Heading><a href={local(`work/${project.slug}/`)}>{project.title}</a></Heading><p class="project-description">{project.description}</p></div>
    <div class="project-actions"><a class="text-link" href={local(`work/${project.slug}/`)} aria-label={`View project: ${project.title}`}>View project <Arrow /></a>{showRepository && project.repository && <a class="repo-link" href={project.repository} aria-label={`GitHub repository: ${project.title}`}><SocialIcon name="github" /> GitHub <Arrow diagonal /></a>}</div>
  </div>
</article>
