---
import Arrow from './Arrow.astro';
import SocialIcon from './SocialIcon.astro';
import { local } from '../lib/urls';
const { project, wide = false, showRepository = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---
<article class:list={['project-preview', { 'project-wide': wide }]}>
  <a class:list={['project-art', `art-${project.cover}`]} href={local(`work/${project.slug}/`)} aria-label={`Read about ${project.title}`} tabindex="-1">
    <picture>
      <source type="image/avif" srcset={`${local(`images/covers/${project.cover}-640.avif`)} 640w, ${local(`images/covers/${project.cover}-1280.avif`)} 1280w`} sizes={wide ? '(max-width: 700px) 100vw, 1200px' : '(max-width: 700px) 100vw, 720px'} />
      <img src={local(`images/covers/${project.cover}-1280.webp`)} srcset={`${local(`images/covers/${project.cover}-640.webp`)} 640w, ${local(`images/covers/${project.cover}-1280.webp`)} 1280w`} sizes={wide ? '(max-width: 700px) 100vw, 1200px' : '(max-width: 700px) 100vw, 720px'} width="1280" height="853" loading={wide || project.number > '03' ? 'lazy' : 'eager'} decoding="async" alt="" />
    </picture>
  </a>
  <div class="project-caption">
    <div><p class="project-meta">{project.category}<span aria-hidden="true"> · </span>{project.tools}</p><Heading><a href={local(`work/${project.slug}/`)}>{project.title}</a></Heading><p class="project-description">{project.description}</p></div>
    <div class="project-actions"><a class="text-link" href={local(`work/${project.slug}/`)} aria-label={`View project: ${project.title}`}>View project <Arrow /></a>{showRepository && project.repository && <a class="repo-link" href={project.repository} aria-label={`GitHub repository: ${project.title}`}><SocialIcon name="github" /> GitHub <Arrow diagonal /></a>}</div>
  </div>
</article>
