---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import TeachingEntry from '../components/TeachingEntry.astro';
import ResumeSection from '../components/ResumeSection.astro';
import { local, email, github, linkedin } from '../lib/urls';
import { profileProjects } from '../data/projects';
import { publications } from '../data/publications';
import { professionalExperience, teachingExperience, recognition, leadership } from '../data/background';
const sections = ['Experience', 'Teaching', 'Education', 'Recognition', 'Skills', 'Projects', 'Publications', 'Leadership'];
const sectionIds = ['professional', 'teaching', 'education', 'recognition', 'skills', 'projects', 'publications', 'leadership'];
---
<BaseLayout title="Resume — Abdelrahman Elsayed" description="Experience, teaching, education, skills, projects, publications, recognition, and leadership in electronics and communications." active="resume">
  <header class="page-heading resume-heading"><p class="eyebrow">Professional profile</p><h1>Experience &amp;<br />background.</h1><p class="lead">Electronics &amp; communications · Embedded systems · Networks</p></header>
  <div class="resume-actions"><a class="button" href={local('Abdelrahman-Elsayed-Resume.pdf')} download>Download resume (PDF) <Arrow /></a><button type="button" class="button button-secondary" id="print-resume">Print full profile <Arrow /></button></div>
  <div class="resume-layout">
    <aside class="cv-sidebar"><nav aria-label="Resume sections"><p class="eyebrow">On this page</p>{sections.map((section, index) => <a href={`#${sectionIds[index]}`}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{section}</a>)}</nav><a class="cv-about-link" href={local('about/')}>A little about me <Arrow /></a></aside>
    <article class="resume-sheet resume-redesign" aria-label="Printable professional profile">
      <header class="cv-introduction"><div><p class="eyebrow">Electronics &amp; communications</p><h2>Abdelrahman<br />Elsayed</h2></div><div class="cv-contact"><p>Montreal, Canada</p><a href={`mailto:${email}`}>{email}</a><div><a href={github}>GitHub <Arrow diagonal /></a><a href={linkedin}>LinkedIn <Arrow diagonal /></a></div></div><p class="cv-summary">Electronics and communications background with a master’s degree and industry and laboratory experience across embedded sensing, 5G/LTE, vehicular, and industrial connectivity. My work includes sensor acquisition, protocol validation, Linux networking, cloud-native integration, simulation, and Python/C++ workflows.</p></header>
      <ResumeSection id="professional" title="Professional experience" number="01" tone="olive"><div class="cv-experience">{professionalExperience.map(role => <article class="cv-entry"><div class="cv-entry-header"><div><h3>{role.organization}</h3><p class="resume-title">{role.title}</p></div><p class="resume-dates">{role.dates}<span class="cv-entry-location">{role.location}</span></p></div><ul>{role.bullets.map(bullet => <li>{bullet}</li>)}</ul></article>)}</div></ResumeSection>
      <ResumeSection id="teaching" title="Teaching experience" number="02" tone="sand">{teachingExperience.map(role => <TeachingEntry role={role} expanded />)}</ResumeSection>
      <ResumeSection id="education" title="Education" number="03" tone="olive"><div class="cv-education"><article class="cv-entry"><span class="cv-degree">M.A.Sc.</span><h3>Industrial Engineering</h3><p class="resume-title">Polytechnique Montréal</p><p class="resume-dates">Jan 2024 – Sep 2026</p><p>Thesis: A Framework for Remote Electric Vehicle Maintenance Communication Using QoS-Aware Network Slicing.</p></article><article class="cv-entry"><span class="cv-degree">B.Sc.</span><h3>Electronics and Communications Engineering</h3><p class="resume-title">Egypt-Japan University of Science and Technology</p><p class="resume-dates">2017–2022</p></article></div></ResumeSection>
      <ResumeSection id="recognition" title="Recognition & research funding" number="04" tone="rose"><div class="cv-recognition">{recognition.map(item => <article class="cv-entry"><h3>{item.title}</h3>{item.dates && <p class="resume-dates">{item.dates}</p>}<p>{item.detail}</p>{item.url && <a class="quiet-link" href={item.url}>{item.linkLabel || 'Program details'} <Arrow diagonal /></a>}</article>)}</div></ResumeSection>
      <ResumeSection id="skills" title="Technical skills" number="05" tone="olive"><dl class="profile-skills"><div><dt>Electronics and embedded systems</dt><dd>Raspberry Pi, ESP32, I2C sensors, USRP/SDR, RF laboratory instruments</dd></div><div><dt>Communication systems</dt><dd>5G NR, LTE, Open5GS, UERANSIM, QoS, network slicing, BLE, C-V2X</dd></div><div><dt>Software and analysis</dt><dd>Python, C++, Bash, MATLAB, Git, Wireshark, TShark, ns-3, OMNeT++, SUMO</dd></div><div><dt>Platforms and integration</dt><dd>Linux networking, Kubernetes, Helm, Docker, Prometheus, Grafana, Loki, MQTT, Siemens PLC, TIA Portal</dd></div></dl></ResumeSection>
      <ResumeSection id="projects" title="Selected projects" number="06" tone="sand"><div class="cv-projects">{profileProjects.map(project => <article class="cv-entry"><h3><a href={local(`work/${project.slug}/`)}>{project.title} <Arrow /></a></h3><p class="resume-dates">{project.tools}</p><p>{project.description}</p></article>)}</div><p class="profile-more"><a class="quiet-link" href={local('work/')}>Explore all projects <Arrow /></a></p></ResumeSection>
      <ResumeSection id="publications" title="Publications" number="07" tone="rose"><div class="cv-publications">{publications.map(publication => <article class="cv-entry"><span class="cv-pub-year">{publication.year}</span><div><h3><a href={publication.url}>{publication.title}</a></h3><p class="resume-dates">{publication.venue}</p><p>{publication.authors}</p><p class="profile-doi">DOI: {publication.doi}</p></div></article>)}</div><p class="profile-more">Earlier publications appear under Abdelrahman Fawaz.</p></ResumeSection>
      <ResumeSection id="leadership" title="Leadership & community" number="08" tone="olive"><div class="cv-leadership">{leadership.map(role => <article class="cv-entry"><h3>{role.organization}</h3><p class="resume-title">{role.title}</p><p class="resume-dates">{role.dates}</p><p>{role.description}</p></article>)}</div></ResumeSection>
    </article>
  </div>
</BaseLayout>
<script>document.getElementById('print-resume')?.addEventListener('click', () => window.print());</script>
